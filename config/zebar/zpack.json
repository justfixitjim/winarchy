{
  "$schema": "https://github.com/glzr-io/zebar/raw/v3.0.0/resources/zpack-schema.json",
  "name": "winarchy",
  "version": "1.12.0",
  "description": "winarchy top bar: GlazeWM workspaces, clock and reminders, toggles, media, audio, Bluetooth, network, system stats and weather. Adapted from the Zebar starter pack (GPL-3.0).",
  "tags": [
    "topbar",
    "glazewm"
  ],
  "previewImages": [],
  "repositoryUrl": "https://github.com/justfixitjim/winarchy",
  "widgets": [
    {
      "name": "bar",
      "htmlPath": "./bar.html",
      "zOrder": "normal",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": true,
      "transparent": true,
      "includeFiles": [
        "*.html",
        "*.css",
        "vendor/*"
      ],
      "caching": {
        "defaultDuration": 604800,
        "rules": []
      },
      "privileges": {
        "shellCommands": [
          {
            "program": "{{WINARCHY_EXE}}",
            "argsRegex": "^(ai|agent|toggle (awake|nightlight|dnd|bar|gaps))?$"
          },
          {
            "program": "explorer.exe",
            "argsRegex": "^ms-settings:sound$"
          },
          {
            "program": "rasdial.exe",
            "argsRegex": ".*"
          },
          {
            "program": "rasdial.exe",
            "argsRegex": ""
          },
          {
            "program": "rasphone.exe",
            "argsRegex": ".*"
          },
          {
            "program": "powershell.exe",
            "argsRegex": "^{{AGENTS_ARGS_RE}} usage$"
          },
          {
            "program": "cmd.exe",
            "argsRegex": "^/c type \"?[^&|<>^\"]*\\\\\\.glzr\\\\winarchy\\\\agents\\\\usage\\.json\"?$"
          },
          {
            "program": "{{TOP_EXE}}",
            "argsRegex": "^summary \\d+$"
          },
          {
            "program": "powershell.exe",
            "argsRegex": "^{{BLUETOOTH_ARGS_RE}} info$"
          },
          {
            "program": "cmd.exe",
            "argsRegex": "^/c type \"?[^&|<>^\"]*\\\\\\.glzr\\\\winarchy\\\\bluetooth\\.json\"?$"
          }
        ]
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_left",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "100%",
          "height": "40px",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": true,
            "edge": "top",
            "windowMargin": "0px"
          }
        }
      ]
    },
    {
      "name": "agents",
      "htmlPath": "./agents.html",
      "zOrder": "top_most",
      "shownInTaskbar": false,
      "focused": true,
      "resizable": false,
      "transparent": true,
      "includeFiles": [
        "*.html",
        "*.css",
        "vendor/*"
      ],
      "caching": {
        "defaultDuration": 604800,
        "rules": []
      },
      "privileges": {
        "shellCommands": [
          {
            "program": "powershell.exe",
            "argsRegex": "^{{AGENTS_ARGS_RE}} (usage( -Refresh)?|use (claude|codex) [A-Za-z0-9_-]+|prefer (claude|codex) [A-Za-z0-9_-]+|mode (claude|codex) (auto|manual) \\d+|add (claude|codex)|switching on)$"
          },
          {
            "program": "cmd.exe",
            "argsRegex": "^/c type \"?[^&|<>^\"]*\\\\\\.glzr\\\\winarchy\\\\agents\\\\usage\\.json\"?$"
          }
        ]
      },
      "presets": [
        {
          "name": "panel",
          "anchor": "top_right",
          "offsetX": "-12px",
          "offsetY": "44px",
          "width": "380px",
          "height": "560px",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": null,
            "windowMargin": "0px"
          }
        }
      ]
    },
    {
      "name": "network",
      "htmlPath": "./network.html",
      "zOrder": "top_most",
      "shownInTaskbar": false,
      "focused": true,
      "resizable": false,
      "transparent": true,
      "includeFiles": [
        "*.html",
        "*.css",
        "vendor/*"
      ],
      "caching": {
        "defaultDuration": 604800,
        "rules": []
      },
      "privileges": {
        "shellCommands": [
          {
            "program": "powershell.exe",
            "argsRegex": "^{{NETWORK_ARGS_RE}} (info|public|password|wifi (on|off)|adapter \\d+ (on|off))$"
          },
          {
            "program": "cmd.exe",
            "argsRegex": "^/c type \"?[^&|<>^\"]*\\\\\\.glzr\\\\winarchy\\\\network\\.json\"?$"
          },
          {
            "program": "explorer.exe",
            "argsRegex": "^ms-settings:network-status$"
          }
        ]
      },
      "presets": [
        {
          "name": "panel",
          "anchor": "top_right",
          "offsetX": "-12px",
          "offsetY": "44px",
          "width": "360px",
          "height": "560px",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": null,
            "windowMargin": "0px"
          }
        }
      ]
    },
    {
      "name": "weather",
      "htmlPath": "./weather.html",
      "zOrder": "top_most",
      "shownInTaskbar": false,
      "focused": true,
      "resizable": false,
      "transparent": true,
      "includeFiles": [
        "*.html",
        "*.css",
        "vendor/*"
      ],
      "caching": {
        "defaultDuration": 604800,
        "rules": []
      },
      "privileges": {
        "shellCommands": []
      },
      "presets": [
        {
          "name": "panel",
          "anchor": "top_right",
          "offsetX": "-12px",
          "offsetY": "44px",
          "width": "340px",
          "height": "520px",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": null,
            "windowMargin": "0px"
          }
        }
      ]
    },
    {
      "name": "processes",
      "htmlPath": "./processes.html",
      "zOrder": "top_most",
      "shownInTaskbar": false,
      "focused": true,
      "resizable": false,
      "transparent": true,
      "includeFiles": [
        "*.html",
        "*.css",
        "vendor/*"
      ],
      "caching": {
        "defaultDuration": 604800,
        "rules": []
      },
      "privileges": {
        "shellCommands": [
          {
            "program": "{{TOP_EXE}}",
            "argsRegex": "^(watch \\d+|kill( \\d+)+)$"
          },
          {
            "program": "taskmgr.exe",
            "argsRegex": ""
          }
        ]
      },
      "presets": [
        {
          "name": "panel",
          "anchor": "top_right",
          "offsetX": "-12px",
          "offsetY": "44px",
          "width": "480px",
          "height": "620px",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": null,
            "windowMargin": "0px"
          }
        }
      ]
    },
    {
      "name": "clock",
      "htmlPath": "./clock.html",
      "zOrder": "top_most",
      "shownInTaskbar": false,
      "focused": true,
      "resizable": false,
      "transparent": true,
      "includeFiles": [
        "*.html",
        "*.css",
        "vendor/*"
      ],
      "caching": {
        "defaultDuration": 604800,
        "rules": []
      },
      "privileges": {
        "shellCommands": [
          {
            "program": "{{WINARCHY_EXE}}",
            "argsRegex": "^remind (add \\d+( [^\r\n]{1,200})?|remove \\d+|clear)$"
          },
          {
            "program": "cmd.exe",
            "argsRegex": "^/c type \"?[^&|<>^\"]*\\\\\\.glzr\\\\winarchy\\\\reminders\\.json\"?$"
          }
        ]
      },
      "presets": [
        {
          "name": "panel",
          "anchor": "top_center",
          "offsetX": "0px",
          "offsetY": "44px",
          "width": "360px",
          "height": "520px",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": null,
            "windowMargin": "0px"
          }
        }
      ]
    },
    {
      "name": "audio",
      "htmlPath": "./audio.html",
      "zOrder": "top_most",
      "shownInTaskbar": false,
      "focused": true,
      "resizable": false,
      "transparent": true,
      "includeFiles": [
        "*.html",
        "*.css",
        "vendor/*"
      ],
      "caching": {
        "defaultDuration": 604800,
        "rules": []
      },
      "privileges": {
        "shellCommands": [
          {
            "program": "{{AUDIO_EXE}}",
            "argsRegex": "^(apps|volume [\\d,]+ \\d+|mute [\\d,]+ (on|off)|default \\{[^ ]+\\}\\.\\{[^ ]+\\})$"
          },
          {
            "program": "explorer.exe",
            "argsRegex": "^ms-settings:sound$"
          }
        ]
      },
      "presets": [
        {
          "name": "panel",
          "anchor": "top_right",
          "offsetX": "-12px",
          "offsetY": "44px",
          "width": "360px",
          "height": "600px",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": null,
            "windowMargin": "0px"
          }
        }
      ]
    },
    {
      "name": "bluetooth",
      "htmlPath": "./bluetooth.html",
      "zOrder": "top_most",
      "shownInTaskbar": false,
      "focused": true,
      "resizable": false,
      "transparent": true,
      "includeFiles": [
        "*.html",
        "*.css",
        "vendor/*"
      ],
      "caching": {
        "defaultDuration": 604800,
        "rules": []
      },
      "privileges": {
        "shellCommands": [
          {
            "program": "powershell.exe",
            "argsRegex": "^{{BLUETOOTH_ARGS_RE}} (info|radio (on|off))$"
          },
          {
            "program": "cmd.exe",
            "argsRegex": "^/c type \"?[^&|<>^\"]*\\\\\\.glzr\\\\winarchy\\\\bluetooth\\.json\"?$"
          },
          {
            "program": "explorer.exe",
            "argsRegex": "^ms-settings:bluetooth$"
          }
        ]
      },
      "presets": [
        {
          "name": "panel",
          "anchor": "top_right",
          "offsetX": "-12px",
          "offsetY": "44px",
          "width": "340px",
          "height": "420px",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": null,
            "windowMargin": "0px"
          }
        }
      ]
    }
  ]
}
