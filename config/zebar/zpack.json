{
  "$schema": "https://github.com/glzr-io/zebar/raw/v3.0.0/resources/zpack-schema.json",
  "name": "winarchy",
  "version": "1.5.0",
  "description": "winarchy top bar: GlazeWM workspaces, clock, system stats and weather. Adapted from the Zebar starter pack (GPL-3.0).",
  "tags": [
    "topbar",
    "glazewm"
  ],
  "previewImages": [],
  "repositoryUrl": "https://github.com/justfixitjim/winarchy",
  "widgets": [
    {
      "name": "bar",
      "htmlPath": "./bar.html",
      "zOrder": "normal",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": true,
      "transparent": true,
      "includeFiles": [
        "*.html",
        "*.css"
      ],
      "caching": {
        "defaultDuration": 604800,
        "rules": []
      },
      "privileges": {
        "shellCommands": [
          {
            "program": "{{WINARCHY_EXE}}",
            "argsRegex": "^(ai)?$"
          },
          {
            "program": "explorer.exe",
            "argsRegex": "^ms-settings:sound$"
          },
          {
            "program": "rasdial.exe",
            "argsRegex": ".*"
          },
          {
            "program": "rasdial.exe",
            "argsRegex": ""
          },
          {
            "program": "rasphone.exe",
            "argsRegex": ".*"
          },
          {
            "program": "powershell.exe",
            "argsRegex": ".*agents\\.ps1 usage$"
          }
        ]
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_left",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "100%",
          "height": "40px",
          "monitorSelection": {
            "type": "all"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": null,
            "windowMargin": "0px"
          }
        }
      ]
    },
    {
      "name": "agents",
      "htmlPath": "./agents.html",
      "zOrder": "top_most",
      "shownInTaskbar": false,
      "focused": true,
      "resizable": false,
      "transparent": true,
      "includeFiles": [
        "*.html",
        "*.css"
      ],
      "caching": {
        "defaultDuration": 604800,
        "rules": []
      },
      "privileges": {
        "shellCommands": [
          {
            "program": "powershell.exe",
            "argsRegex": ".*agents\\.ps1 (usage( -Refresh)?|use (claude|codex) [A-Za-z0-9_-]+|mode (claude|codex) (auto|manual) \\d+|add (claude|codex))$"
          }
        ]
      },
      "presets": [
        {
          "name": "panel",
          "anchor": "top_right",
          "offsetX": "-12px",
          "offsetY": "44px",
          "width": "380px",
          "height": "560px",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": null,
            "windowMargin": "0px"
          }
        }
      ]
    }
  ]
}
