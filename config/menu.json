{
  "_help": "winarchy menu (Super+Space / Super+Alt+Space), laid out like Omarchy's. Each item has a label and ONE of: run (+args), glaze (GlazeWM command), terminal (PowerShell in Windows Terminal), page (an id, or 'keys'), items (a submenu) or provider ('apps' = every installed app, 'settings' = every Windows Settings page). Optional: hint, confirm, id. %ENV% vars are expanded; {dir} = the winarchy folder, {menu} = this file. Typing searches everything: apps, open windows, settings and every item below.",
  "root": {
    "label": "winarchy",
    "items": [
      {
        "label": "Apps",
        "provider": "apps",
        "items": []
      },
      {
        "label": "Appearance",
        "items": [
          {
            "label": "Theme & accent colour",
            "run": "ms-settings:colors"
          },
          {
            "label": "Background",
            "run": "ms-settings:personalization-background"
          },
          {
            "label": "Font",
            "run": "ms-settings:fonts"
          },
          {
            "label": "Menu Bar",
            "items": [
              {
                "label": "Show / hide bar",
                "hint": "Zebar",
                "run": "powershell.exe",
                "args": "-NoProfile -WindowStyle Hidden -Command \"if (Get-Process zebar -ErrorAction SilentlyContinue) { Stop-Process -Name zebar } else { Start-Process \\\"$env:ProgramFiles\\glzr.io\\Zebar\\zebar.exe\\\" }\""
              },
              {
                "label": "Show / hide Windows taskbar",
                "run": "{dir}\\winarchy.exe",
                "args": "taskbar"
              },
              {
                "label": "Edit bar widgets",
                "hint": "Zebar",
                "run": "{dir}\\winarchy.exe",
                "args": "launch edit \"%USERPROFILE%\\.glzr\\zebar\\winarchy\""
              }
            ]
          },
          {
            "label": "Windows",
            "items": [
              {
                "label": "Borders, gaps & colours",
                "hint": "GlazeWM config",
                "run": "{dir}\\winarchy.exe",
                "args": "launch edit \"%USERPROFILE%\\.glzr\\glazewm\\config.yaml\""
              },
              {
                "label": "Snap windows",
                "run": "ms-settings:multitasking"
              }
            ]
          },
          {
            "label": "Animations",
            "run": "ms-settings:easeofaccess-visualeffects"
          }
        ]
      },
      {
        "label": "Trigger",
        "items": [
          {
            "label": "Toggle",
            "items": [
              {
                "label": "Pause tiling",
                "hint": "Super+Shift+P",
                "glaze": "wm-toggle-pause"
              },
              {
                "label": "Windows taskbar",
                "run": "{dir}\\winarchy.exe",
                "args": "taskbar"
              },
              {
                "label": "Night light",
                "run": "ms-settings:nightlight"
              },
              {
                "label": "Do not disturb",
                "run": "ms-settings:notifications"
              }
            ]
          },
          {
            "label": "Capture",
            "items": [
              {
                "label": "Screenshot",
                "hint": "Super+Shift+S",
                "run": "ms-screenclip:"
              },
              {
                "label": "Screen recording (start / stop)",
                "run": "powershell.exe",
                "args": "-NoProfile -STA -ExecutionPolicy Bypass -WindowStyle Hidden -File \"{dir}\\tools\\record.ps1\"",
                "hint": "this monitor"
              },
              {
                "label": "Text (OCR)",
                "run": "powershell.exe",
                "args": "-NoProfile -STA -ExecutionPolicy Bypass -WindowStyle Hidden -File \"{dir}\\tools\\capture-text.ps1\"",
                "hint": "copies text"
              },
              {
                "label": "QR code",
                "run": "powershell.exe",
                "args": "-NoProfile -STA -ExecutionPolicy Bypass -WindowStyle Hidden -File \"{dir}\\tools\\capture-qr.ps1\"",
                "hint": "copies contents"
              },
              {
                "label": "Snipping Tool",
                "run": "explorer.exe",
                "args": "shell:AppsFolder\\Microsoft.ScreenSketch_8wekyb3d8bbwe!App"
              }
            ]
          },
          {
            "label": "Transcode",
            "hint": "picture or video",
            "terminal": "Set-ExecutionPolicy -Scope Process Bypass -Force; try { & \"$env:USERPROFILE\\.glzr\\winarchy\\tools\\transcode.ps1\" } catch { Write-Host $_ -ForegroundColor Red; Read-Host 'Press Enter to close' }; exit"
          },
          {
            "label": "Clipboard settings",
            "hint": "history: Super+V",
            "run": "ms-settings:clipboard"
          },
          {
            "label": "Speed Test",
            "items": [
              {
                "label": "Network speed test",
                "run": "https://fast.com"
              }
            ]
          }
        ]
      },
      {
        "label": "Setup",
        "id": "setup",
        "items": [
          {
            "label": "Defaults",
            "items": [
              {
                "label": "Default apps",
                "run": "ms-settings:defaultapps"
              },
              {
                "label": "Dictation (Handy)",
                "hint": "Right Ctrl",
                "run": "{dir}\\winarchy.exe",
                "args": "launch app Handy cjpais.Handy"
              }
            ]
          },
          {
            "label": "Audio",
            "run": "ms-settings:sound"
          },
          {
            "label": "Network",
            "items": [
              {
                "label": "Wi-Fi",
                "run": "ms-settings:network-wifi"
              },
              {
                "label": "Network status",
                "run": "ms-settings:network-status"
              },
              {
                "label": "VPN",
                "run": "ms-settings:network-vpn"
              },
              {
                "label": "Share Wi-Fi as QR code",
                "run": "powershell.exe",
                "args": "-NoProfile -STA -ExecutionPolicy Bypass -WindowStyle Hidden -File \"{dir}\\tools\\wifi-qr.ps1\""
              }
            ]
          },
          {
            "label": "Bluetooth",
            "run": "ms-settings:bluetooth"
          },
          {
            "label": "Displays",
            "run": "ms-settings:display"
          },
          {
            "label": "Power & sleep",
            "run": "ms-settings:powersleep"
          },
          {
            "label": "Keyboard",
            "items": [
              {
                "label": "Keybindings",
                "hint": "Super+K",
                "page": "keys"
              },
              {
                "label": "Keyboard settings",
                "run": "ms-settings:keyboard"
              },
              {
                "label": "Typing",
                "run": "ms-settings:typing"
              }
            ]
          },
          {
            "label": "Mouse",
            "run": "ms-settings:mousetouchpad"
          },
          {
            "label": "Region",
            "items": [
              {
                "label": "Language & region",
                "run": "ms-settings:regionlanguage"
              },
              {
                "label": "Date & time",
                "run": "ms-settings:dateandtime"
              }
            ]
          },
          {
            "label": "Printers",
            "run": "ms-settings:printers"
          },
          {
            "label": "Startup apps",
            "run": "ms-settings:startupapps"
          },
          {
            "label": "Config",
            "id": "config",
            "items": [
              {
                "label": "GlazeWM config",
                "run": "{dir}\\winarchy.exe",
                "args": "launch edit \"%USERPROFILE%\\.glzr\\glazewm\\config.yaml\""
              },
              {
                "label": "This menu",
                "run": "{dir}\\winarchy.exe",
                "args": "launch edit \"{menu}\""
              },
              {
                "label": "winarchy folder",
                "run": "{dir}\\winarchy.exe",
                "args": "launch edit \"{dir}\""
              },
              {
                "label": "PowerToys settings",
                "run": "{dir}\\winarchy.exe",
                "args": "launch app PowerToys Microsoft.PowerToys"
              },
              {
                "label": "Quit GlazeWM",
                "glaze": "wm-exit",
                "confirm": true
              }
            ]
          },
          {
            "label": "All Windows settings",
            "provider": "settings",
            "items": []
          }
        ]
      },
      {
        "label": "Install",
