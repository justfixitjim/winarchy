      {
        "label": "Remove",
        "items": [
          {
            "label": "Package",
            "hint": "winget",
            "terminal": "$q = Read-Host 'Find installed app'; winget list $q; $id = Read-Host 'Package Id to uninstall (blank to cancel)'; if ($id) { winget uninstall --id $id -e }"
          },
          {
            "label": "Installed apps",
            "run": "ms-settings:appsfeatures"
          }
        ]
      },
      {
        "label": "Update",
        "items": [
          {
            "label": "winarchy",
            "hint": "re-run installer",
            "terminal": "irm https://raw.githubusercontent.com/justfixitjim/winarchy/main/install.ps1 | iex"
          },
          {
            "label": "All apps",
            "hint": "winget",
            "terminal": "winget upgrade; if ((Read-Host 'Upgrade all of these? (y/N)') -eq 'y') { winget upgrade --all }"
          },
          {
            "label": "Windows",
            "run": "ms-settings:windowsupdate"
          },
          {
            "label": "Store apps",
            "run": "ms-windows-store://downloadsandupdates"
          },
          {
            "label": "Process",
            "items": [
              {
                "label": "Restart GlazeWM",
                "run": "cmd.exe",
                "args": "/c \"\"%ProgramFiles%\\glzr.io\\GlazeWM\\cli\\glazewm.exe\" command wm-exit & timeout /t 2 /nobreak >nul & start \"\" \"%ProgramFiles%\\glzr.io\\GlazeWM\\glazewm.exe\"\""
              },
              {
                "label": "Reload GlazeWM config",
                "hint": "Super+Ctrl+R",
                "glaze": "wm-reload-config"
              },
              {
                "label": "Redraw windows",
                "glaze": "wm-redraw"
              },
              {
                "label": "Restart bar",
                "hint": "Zebar",
                "run": "powershell.exe",
                "args": "-NoProfile -WindowStyle Hidden -Command \"Stop-Process -Name zebar -ErrorAction SilentlyContinue; Start-Sleep 1; Start-Process \\\"$env:ProgramFiles\\glzr.io\\Zebar\\zebar.exe\\\"\""
              },
              {
                "label": "Restart dictation",
                "hint": "Handy",
                "run": "powershell.exe",
                "args": "-NoProfile -WindowStyle Hidden -Command \"Stop-Process -Name handy -ErrorAction SilentlyContinue; Start-Sleep 1; Start-Process \\\"$env:LOCALAPPDATA\\Handy\\handy.exe\\\"\""
              }
            ]
