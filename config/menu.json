{
  "_help": "winarchy menu (Super+Space / Super+Alt+Space), laid out like Omarchy's. Each item has a label and ONE of: run (+args), glaze (GlazeWM command), terminal (PowerShell in Windows Terminal), page (an id, or 'keys'), items (a submenu) or provider ('apps' = every installed app, 'settings' = every Windows Settings page, 'themes' = the colour themes). Optional: hint, confirm, id. %ENV% vars are expanded; {dir} = the winarchy folder, {menu} = this file, {glazewm} / {glazewm-cli} / {zebar} = those programs. Typing searches everything: apps, open windows, settings and every item below.",
  "root": {
    "label": "winarchy",
    "items": [
      {
        "label": "Apps",
        "provider": "apps",
        "items": []
      },
      {
        "label": "AI",
        "id": "ai",
        "hint": "usage and accounts",
        "items": [
          {
            "label": "Agent workspace",
            "hint": "herdr  Super+Shift+Enter",
            "terminal": "try { & \"$env:LOCALAPPDATA\\Programs\\Herdr\\bin\\herdr.exe\" } catch { Write-Host 'herdr is not installed. Re-run the winarchy installer, or see https://herdr.dev' -ForegroundColor Red; Read-Host 'Press Enter to close' }; exit"
          },
          {
            "label": "Launch default agent",
            "hint": "Super+Shift+Ctrl+A",
            "run": "{dir}\\winarchy.exe",
            "args": "agent"
          },
          {
            "label": "Default agent",
            "hint": "pick one",
            "provider": "agents",
            "items": []
          },
          {
            "label": "Usage",
            "hint": "every account",
            "terminal": "Set-ExecutionPolicy -Scope Process Bypass -Force; try { & \"$env:USERPROFILE\\.glzr\\winarchy\\tools\\agents.ps1\" status } catch { Write-Host $_ -ForegroundColor Red }; Read-Host 'Press Enter to close'; exit"
          },
          {
            "label": "Account switching",
            "hint": "several subscriptions",
            "items": [
              {
                "label": "Turn on",
                "hint": "swaps Claude Code / Codex sign-ins",
                "run": "powershell.exe",
                "args": "-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File \"{dir}\\tools\\agents.ps1\" switching on"
              },
              {
                "label": "Turn off",
                "hint": "sign-ins stay as they are",
                "run": "powershell.exe",
                "args": "-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File \"{dir}\\tools\\agents.ps1\" switching off"
              }
            ]
          },
          {
            "label": "Claude Code",
            "items": [
              {
                "label": "Switch account",
                "hint": "next account",
                "run": "powershell.exe",
                "args": "-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File \"{dir}\\tools\\agents.ps1\" use claude next"
              },
              {
                "label": "Add account",
                "hint": "sign in",
                "terminal": "Set-ExecutionPolicy -Scope Process Bypass -Force; try { & \"$env:USERPROFILE\\.glzr\\winarchy\\tools\\agents.ps1\" add claude } catch { Write-Host $_ -ForegroundColor Red }; exit"
              },
              {
                "label": "Accounts",
                "hint": "list / remove",
                "terminal": "Set-ExecutionPolicy -Scope Process Bypass -Force; try { & \"$env:USERPROFILE\\.glzr\\winarchy\\tools\\agents.ps1\" list claude; $id = Read-Host 'Account id to remove (Enter to keep all)'; if ($id) { & \"$env:USERPROFILE\\.glzr\\winarchy\\tools\\agents.ps1\" remove claude $id } } catch { Write-Host $_ -ForegroundColor Red }; Read-Host 'Press Enter to close'; exit"
              },
              {
                "label": "Auto-switch at 90%",
                "hint": "most headroom",
                "run": "powershell.exe",
                "args": "-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File \"{dir}\\tools\\agents.ps1\" mode claude auto 90"
              },
              {
                "label": "Alert only at 90%",
                "hint": "switch yourself",
                "run": "powershell.exe",
                "args": "-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File \"{dir}\\tools\\agents.ps1\" mode claude manual 90"
              }
            ]
          },
          {
            "label": "Codex",
            "items": [
              {
                "label": "Switch account",
                "hint": "next account",
                "run": "powershell.exe",
                "args": "-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File \"{dir}\\tools\\agents.ps1\" use codex next"
              },
              {
                "label": "Add account",
                "hint": "sign in",
