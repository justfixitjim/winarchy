{
  "_help": "Omarchy-style menu shown by Super+Alt+Space. Each item has a label plus ONE action: run (+args), glaze (GlazeWM command), terminal (PowerShell in Windows Terminal), page (jump to an id, or 'keys'), or items (a submenu). Optional: hint, confirm, id. %ENV% vars are expanded; {dir} = the winarchy folder, {menu} = this file.",
  "root": {
    "label": "Go",
    "items": [
      {
        "label": "Apps",
        "hint": "Super+Space",
        "page": "launcher"
      },
      {
        "label": "Learn",
        "items": [
          {
            "label": "Keybindings",
            "hint": "Super+K",
            "page": "keys"
          },
          {
            "label": "winarchy on GitHub",
            "run": "https://github.com/justfixitjim/winarchy#readme"
          },
          {
            "label": "GlazeWM docs",
            "run": "https://github.com/glzr-io/glazewm#readme"
          },
          {
            "label": "Omarchy manual",
            "run": "https://learn.omacom.io/2/the-omarchy-manual"
          }
        ]
      },
      {
        "label": "Capture",
        "items": [
          {
            "label": "Screenshot region",
            "hint": "Super+Shift+S",
            "run": "ms-screenclip:"
          },
          {
            "label": "Screen recording",
            "hint": "Snipping Tool",
            "run": "explorer.exe",
            "args": "shell:AppsFolder\\Microsoft.ScreenSketch_8wekyb3d8bbwe!App"
          }
        ]
      },
      {
        "label": "Toggle",
        "items": [
          {
            "label": "Pause tiling",
            "hint": "Super+Shift+P",
            "glaze": "wm-toggle-pause"
          },
          {
            "label": "Taskbar",
            "run": "{dir}\\winarchy.exe",
            "args": "taskbar"
          },
          {
            "label": "Status bar (Zebar)",
            "run": "powershell.exe",
            "args": "-NoProfile -WindowStyle Hidden -Command \"if (Get-Process zebar -ErrorAction SilentlyContinue) { Stop-Process -Name zebar } else { Start-Process \\\"$env:ProgramFiles\\glzr.io\\Zebar\\zebar.exe\\\" }\""
          },
          {
            "label": "Night light",
            "run": "ms-settings:nightlight"
          },
          {
            "label": "Do not disturb",
            "run": "ms-settings:notifications"
          }
        ]
      },
      {
        "label": "Style",
        "items": [
          {
            "label": "Theme & accent colour",
            "run": "ms-settings:colors"
          },
          {
            "label": "Background",
            "run": "ms-settings:personalization-background"
          },
          {
            "label": "Window borders & gaps",
            "hint": "GlazeWM config",
            "run": "{dir}\\winarchy.exe",
            "args": "launch edit \"%USERPROFILE%\\.glzr\\glazewm\\config.yaml\""
          },
          {
            "label": "Status bar widgets",
            "hint": "Zebar",
            "run": "{dir}\\winarchy.exe",
            "args": "launch edit \"%USERPROFILE%\\.glzr\\zebar\""
          }
        ]
      },
      {
        "id": "setup",
        "label": "Setup",
        "items": [
          {
            "label": "Dictation (Handy)",
            "hint": "Right Ctrl",
            "run": "{dir}\\winarchy.exe",
            "args": "launch app Handy cjpais.Handy"
          },
          {
            "label": "Audio",
            "run": "ms-settings:sound"
          },
          {
            "label": "Wi-Fi",
            "run": "ms-settings:network-wifi"
          },
          {
            "label": "Bluetooth",
            "run": "ms-settings:bluetooth"
          },
          {
            "label": "Displays",
            "run": "ms-settings:display"
          },
          {
            "label": "Power & sleep",
            "run": "ms-settings:powersleep"
          },
          {
            "label": "Keyboard",
            "run": "ms-settings:keyboard"
          },
          {
            "label": "Mouse",
            "run": "ms-settings:mousetouchpad"
          },
          {
            "label": "Printers",
            "run": "ms-settings:printers"
          },
          {
            "label": "Default apps",
            "run": "ms-settings:defaultapps"
          },
          {
            "label": "Startup apps",
            "run": "ms-settings:startupapps"
          },
          {
            "label": "Taskbar (auto-hide)",
            "run": "ms-settings:taskbar"
          },
          {
            "label": "Snap windows",
            "run": "ms-settings:multitasking"
          },
          {
            "label": "Animation effects",
            "run": "ms-settings:easeofaccess-visualeffects"
          },
          {
            "id": "config",
            "label": "Config",
            "items": [
              {
                "label": "GlazeWM config",
                "run": "{dir}\\winarchy.exe",
                "args": "launch edit \"%USERPROFILE%\\.glzr\\glazewm\\config.yaml\""
              },
              {
                "label": "This menu",
                "run": "{dir}\\winarchy.exe",
                "args": "launch edit \"{menu}\""
              },
              {
                "label": "winarchy folder",
                "run": "{dir}\\winarchy.exe",
                "args": "launch edit \"{dir}\""
              },
              {
                "label": "PowerToys settings",
                "run": "{dir}\\winarchy.exe",
                "args": "launch app PowerToys Microsoft.PowerToys"
              },
              {
                "label": "Reload GlazeWM config",
                "hint": "Super+Ctrl+R",
                "glaze": "wm-reload-config"
              },
              {
                "label": "Redraw windows",
                "glaze": "wm-redraw"
              },
              {
                "label": "Restart GlazeWM",
                "run": "cmd.exe",
                "args": "/c \"\"%ProgramFiles%\\glzr.io\\GlazeWM\\cli\\glazewm.exe\" command wm-exit & timeout /t 2 /nobreak >nul & start \"\" \"%ProgramFiles%\\glzr.io\\GlazeWM\\glazewm.exe\"\""
              },
              {
                "label": "Quit GlazeWM",
                "glaze": "wm-exit",
                "confirm": true
              }
            ]
          }
        ]
      },
      {
        "label": "Install",
        "items": [
          {
            "label": "Search & install an app",
            "hint": "winget",
            "terminal": "$q = Read-Host 'Search winget for'; winget search $q; $id = Read-Host 'Package Id to install (blank to cancel)'; if ($id) { winget install --id $id -e }"
          },
          {
            "label": "Dictation (Handy)",
            "hint": "winget",
            "terminal": "winget install --id cjpais.Handy -e"
          },
          {
            "label": "Microsoft Store",
            "run": "ms-windows-store:"
          }
        ]
      },
      {
        "label": "Remove",
        "items": [
          {
            "label": "Uninstall an app",
            "run": "ms-settings:appsfeatures"
          },
          {
            "label": "Uninstall with winget",
            "hint": "winget",
            "terminal": "$q = Read-Host 'Find installed app'; winget list $q; $id = Read-Host 'Package Id to uninstall (blank to cancel)'; if ($id) { winget uninstall --id $id -e }"
          }
        ]
      },
      {
        "label": "Update",
        "items": [
          {
            "label": "Update all apps",
            "hint": "winget",
            "terminal": "winget upgrade; if ((Read-Host 'Upgrade all of these? (y/N)') -eq 'y') { winget upgrade --all }"
          },
          {
            "label": "Windows Update",
            "run": "ms-settings:windowsupdate"
          },
          {
            "label": "Store app updates",
            "run": "ms-windows-store://downloadsandupdates"
          }
        ]
      },
      {
        "label": "About this PC",
        "run": "ms-settings:about"
      },
      {
        "id": "system",
        "label": "System",
        "items": [
          {
            "label": "Lock",
            "hint": "Super+L",
            "run": "rundll32.exe",
            "args": "user32.dll,LockWorkStation"
          },
          {
            "label": "Sleep",
            "builtin": "sleep"
          },
          {
            "label": "Sign out",
            "run": "shutdown.exe",
            "args": "/l",
            "confirm": true
          },
          {
            "label": "Restart",
            "run": "shutdown.exe",
            "args": "/r /t 0",
            "confirm": true
          },
          {
            "label": "Shut down",
            "run": "shutdown.exe",
            "args": "/s /t 0",
            "confirm": true
          }
        ]
      }
    ]
  }
}
