              },
              {
                "label": "Accounts",
                "hint": "list / remove",
                "terminal": "Set-ExecutionPolicy -Scope Process Bypass -Force; try { & \"$env:USERPROFILE\\.glzr\\winarchy\\tools\\agents.ps1\" list codex; $id = Read-Host 'Account id to remove (Enter to keep all)'; if ($id) { & \"$env:USERPROFILE\\.glzr\\winarchy\\tools\\agents.ps1\" remove codex $id } } catch { Write-Host $_ -ForegroundColor Red }; Read-Host 'Press Enter to close'; exit"
